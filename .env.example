# --- Database (XAMPP MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autoclip
DB_USER=autoclip
DB_PASSWORD=ganti_dengan_password_kuat

# --- Lokasi data (relatif terhadap folder proyek, jadi tetap di Drive D) ---
STORAGE_DIR=./storage
MODEL_DIR=./storage/models

# --- Transkripsi ---
WHISPER_MODEL=base
WHISPER_THREADS=4
MAX_DURATION_MIN=20