# --- Database (XAMPP MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autoclip
DB_USER=autoclip
DB_PASSWORD=ganti_dengan_password_kuat

# --- Lokasi data (relatif terhadap folder proyek, jadi tetap di Drive D) ---
STORAGE_DIR=./storage
MODEL_DIR=./storage/models

# --- Transkripsi ---
WHISPER_MODEL=base
WHISPER_THREADS=4
# Batas durasi video (menit). Kosong atau 0 = tanpa batas. Video panjang butuh waktu proses dan ruang disk besar.
MAX_DURATION_MIN=0
# Gemini (opsional, gratis) untuk judul/caption/hashtag: python -m core.jalankan video.mp4 --llm
# Kunci dibuat di aistudio.google.com. Isi di .env (BUKAN di berkas ini). .env tidak ikut Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Login web ---
# Kunci rahasia untuk tanda tangan cookie sesi (minimal 32 karakter). Kosong = acak setiap server dinyalakan
# (semua orang keluar saat server dimulai ulang). Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_DAYS=7
COOKIE_SECURE=0
